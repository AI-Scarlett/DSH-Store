[Unit]
Description=Refresh the %i DSH STORE from the validated GitHub Pages artifact
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/dsh-store/refresh-%i.env
ExecStart=/opt/dsh-store/bin/refresh-from-pages.sh
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/dsh-store -/opt/dsh-store-cn /run/lock
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
