{
  "schemaVersion": 1,
  "policy": "github-person-once-v1",
  "authority": "AI-Scarlett/DSH-Store",
  "stateBranch": "author-contact-state",
  "statePath": "contacts.json",
  "initialContactLimitPerPerson": 1,
  "identity": "github-immutable-user-id",
