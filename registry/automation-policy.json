{
  "schemaVersion": 1,
  "scheduleHours": 8,
  "search": {
    "queries": [
      "topic:dsh-plugin",
      "topic:deepseek-harness",
      "dsh-plugin in:name,description,readme",
      "\"deepseek harness\" plugin in:name,description,readme"
    ],
    "resultsPerQuery": 20,
    "maxNewRepositoriesPerRun": 8,
    "excludedRepositories": [
      {
        "repositoryUrl": "https://github.com/mengxingGG/dsh-desktop",
        "reason": "Author confirmed this is a complete DSH downstream distribution, not an installable plugin.",
        "evidenceUrl": "https://github.com/AI-Scarlett/DSH-Store/issues/230#issuecomment-5426569042"
      },
      {
        "repositoryUrl": "https://github.com/DDDFXYqiming/Agent_Extensions",
        "reason": "作者已确认该仓库是通用 Agent Skills 与 Hermes 插件合集；DSH 插件已拆分至独立仓库。",
        "evidenceUrl": "https://github.com/AI-Scarlett/DSH-Store/issues/709#issuecomment-5648018280"
      }
    ]
  },
  "sourceBounds": {
    "maxTreeEntries": 1200,
    "maxRuntimeFiles": 512,
    "maxFileBytes": 4194304,
    "maxTotalRuntimeBytes": 8388608
  },
  "updates": {
    "checkAllCatalogEntries": true,
    "versionAuthority": "canonical-github-default-branch-manifest-at-fixed-commit",
    "concurrency": 8,
    "maxCommitSpan": 200
  },
  "authorFeedback": {
    "source": "verified-authors-on-managed-issue-comments",
    "classification": "dsh-store-problem",
    "ownerNotification": {
      "channel": "github-issue-comment",
      "mention": "@AI-Scarlett",
      "markerPrefix": "dsh-author-feedback:v1",
      "oncePerFeedbackComment": true,
      "githubNotificationEmailDeliveryVerified": false
    },
    "automaticAuthorReplies": false,
    "requiresVerifiedAuthorIdentity": true
  },
  "compatibility": {
    "authority": "official-github-releases-and-npm-published-versions",
    "registryUrl": "https://registry.npmjs.org/@deepseek-ai%2Fdsh",
    "latestReleaseCount": 3,
    "requiredCompatibleReleases": 1,
    "unsupportedCatalogStatus": "blocked",
    "candidateStatus": "reviewing",
    "failClosedOnAuthorityError": true
  },
  "candidateRetention": {
    "authority": "candidate-fixed-commit-package-manifests",
    "pruneRejectedWithoutLatestThreeCompatibility": true,
    "exactReleaseEvidenceRequired": true,
    "scanBuckets": 24,
    "maxCandidatesPerRun": 96,
    "maxTreeEntries": 1200,
    "maxManifestCandidates": 48,
    "maxManifestBytes": 262144,
    "concurrency": 8
  },
  "automaticApproval": {
    "requireManifestRepositoryMatch": true,
    "requireRepositoryLicenseMatch": true,
    "requireExplicitFiles": true,
    "requireDshCompatibility": true,
    "requireNodeCompatibility": true,
    "allowLifecycleScripts": false,
    "allowRuntimeDependencies": false,
    "allowSymlinks": false,
    "allowSubmodules": false,
    "permissionSignals": {
      "files": false,
      "network": false,
      "commands": false,
      "credentials": false,
      "protectedDsh": false,
      "nativeOrExecutableArtifacts": false
    }
  },
  "publication": {
    "repository": "AI-Scarlett/DSH-Store",
    "catalogPath": "registry/catalog.json",
    "candidatesPath": "registry/candidates.json",
    "pullRequestBranchPrefix": "automation/catalog-",
    "mergeMethod": "squash",
    "publicCatalogUrls": [
      "https://raw.githubusercontent.com/AI-Scarlett/DSH-Store/main/registry/catalog.json",
      "https://ai-scarlett.github.io/DSH-Store/registry/catalog.json",
      "https://dsh.store/registry/catalog.json",
      "https://dsh-store.cn/registry/catalog.json"
    ],
    "publicRepairUrls": [
      "https://ai-scarlett.github.io/DSH-Store/marketplace/repair/",
      "https://dsh.store/repair/",
      "https://dsh-store.cn/repair/"
    ]
  },
  "discoveryFeeds": {
    "enabled": true,
    "repository": "awesome-dsh-plugin/awesome-dsh-plugin",
    "admission": "candidate-only",
    "maxRecordsPerRun": 8,
    "contactAuthors": false
  },
  "admissionReview": {
    "path": "registry/admission-reviews.json",
    "engine": "bounded-source-v2",
    "unknownBlocksInstallation": true
  }
}
