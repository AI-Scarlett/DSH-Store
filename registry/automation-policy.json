{
  "schemaVersion": 1,
  "scheduleHours": 8,
  "search": {
    "queries": [
      "topic:dsh-plugin",
      "topic:deepseek-harness",
      "dsh-plugin in:name,description,readme",
      "\"deepseek harness\" plugin in:name,description,readme"
    ],
    "resultsPerQuery": 20,
    "maxNewRepositoriesPerRun": 8
  },
  "sourceBounds": {
    "maxTreeEntries": 1200,
    "maxRuntimeFiles": 240,
    "maxFileBytes": 262144,
    "maxTotalRuntimeBytes": 2097152
  },
  "updates": {
    "checkAllCatalogEntries": true,
    "versionAuthority": "canonical-github-default-branch-manifest-at-fixed-commit",
    "concurrency": 8,
    "maxCommitSpan": 200
  },
  "compatibility": {
    "authority": "official-npm-registry-active-supported-channels-through-highest",
    "registryUrl": "https://registry.npmjs.org/@deepseek-ai%2Fdsh",
    "latestReleaseCount": 3,
    "requiredCompatibleReleases": 1,
    "unsupportedCatalogStatus": "unlisted",
    "candidateStatus": "reviewing",
    "failClosedOnAuthorityError": true
  },
  "candidateRetention": {
    "authority": "candidate-fixed-commit-package-manifests",
    "pruneRejectedWithoutLatestThreeCompatibility": true,
    "exactReleaseEvidenceRequired": true,
    "scanBuckets": 24,
    "maxCandidatesPerRun": 96,
    "maxTreeEntries": 1200,
    "maxManifestCandidates": 48,
    "maxManifestBytes": 262144,
    "concurrency": 8
  },
  "automaticApproval": {
    "requireManifestRepositoryMatch": true,
    "requireRepositoryLicenseMatch": true,
    "requireExplicitFiles": true,
    "requireDshCompatibility": true,
    "requireNodeCompatibility": true,
    "allowLifecycleScripts": false,
    "allowRuntimeDependencies": false,
    "allowSymlinks": false,
    "allowSubmodules": false,
    "permissionSignals": {
      "files": false,
      "network": false,
      "commands": false,
      "credentials": false,
      "protectedDsh": false,
      "nativeOrExecutableArtifacts": false
    }
  },
  "publication": {
    "repository": "AI-Scarlett/DSH-Store",
    "catalogPath": "registry/catalog.json",
    "candidatesPath": "registry/candidates.json",
    "pullRequestBranchPrefix": "automation/catalog-",
    "mergeMethod": "squash",
    "publicCatalogUrls": [
      "https://raw.githubusercontent.com/AI-Scarlett/DSH-Store/main/registry/catalog.json",
      "https://ai-scarlett.github.io/DSH-Store/registry/catalog.json",
      "https://dsh.store/registry/catalog.json",
      "https://dsh-store.cn/registry/catalog.json"
    ]
  }
}
