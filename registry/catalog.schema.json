{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-Scarlett/dsh-safe-plugin-manager/registry/catalog.schema.json",
  "title": "DSH Safe GitHub Plugin Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registry", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registry": {
      "type": "object",
      "required": ["name", "repositoryUrl", "updatedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "homepageUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "packageName", "description", "repositoryUrl", "commit", "version", "entryIds", "status", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
          "name": { "type": "string", "minLength": 1 },
          "packageName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "defaultBranch": { "type": "string" },
          "manifestPath": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "entryIds": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["approved", "blocked"] },
          "statusReason": { "type": "string" },
          "compatibility": { "type": "object" },
          "risk": {
            "type": "object",
            "required": ["installScripts", "review"],
            "properties": {
              "installScripts": { "type": "array", "items": { "enum": ["preinstall", "install", "postinstall", "prepare"] } },
              "review": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
