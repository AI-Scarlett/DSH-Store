{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-Scarlett/dsh-safe-plugin-manager/registry/catalog.schema.json",
  "title": "DSH Safe GitHub Plugin Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registry", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registry": {
      "type": "object",
      "required": ["name", "repositoryUrl", "updatedAt", "sourceUpdates"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "homepageUrl": { "type": "string" },
        "installCountsUrl": { "type": "string", "pattern": "^https://" },
        "updatedAt": { "type": "string" },
        "sourceUpdates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "defaultPolicy"],
          "properties": {
            "mode": { "const": "client-on-demand" },
            "defaultPolicy": { "const": "risk-derived" }
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "packageName", "description", "repositoryUrl", "commit", "version", "entryIds", "status", "compatibility", "details", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
          "name": { "type": "string", "minLength": 1 },
          "packageName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "repositoryUrl": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "defaultBranch": { "type": "string" },
          "manifestPath": { "type": "string" },
          "installPath": { "type": "string" },
          "updatePolicy": { "enum": ["source-verified", "registry-reviewed"] },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "featured": { "type": "boolean" },
          "installCount": { "type": "integer", "minimum": 0 },
          "entryIds": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["approved", "blocked", "unlisted"] },
          "statusReason": { "type": "string" },
          "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dsh", "node", "systems", "profiles"],
            "properties": {
              "dsh": { "type": ["string", "null"] },
              "node": { "type": ["string", "null"] },
              "systems": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginType", "installSource", "license", "permissions", "externalDependencies", "reviewStatus"],
            "properties": {
              "pluginType": { "enum": ["feature", "theme", "suite", "client", "provider", "unknown"] },
              "installSource": { "enum": ["npm", "github", "local-bundle", "unknown"] },
              "license": { "type": "string", "minLength": 1 },
              "permissions": {
                "type": "object",
                "additionalProperties": false,
                "required": ["level", "files", "network", "commands", "credentials"],
                "properties": {
                  "level": { "enum": ["low", "medium", "high", "unknown"] },
                  "files": { "enum": ["none", "read-only", "write", "unknown"] },
                  "network": { "enum": ["none", "specified-services", "any", "unknown"] },
                  "commands": { "enum": ["none", "restricted", "shell", "unknown"] },
                  "credentials": {
                    "type": "array",
                    "items": { "enum": ["none", "api-key", "oauth", "keychain", "unknown"] },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                }
              },
              "externalDependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "reviewStatus": { "enum": ["unreviewed", "automated-scan", "manual-review", "author-verified"] }
            }
          },
          "risk": {
            "type": "object",
            "required": ["installScripts", "review"],
            "properties": {
              "installScripts": { "type": "array", "items": { "enum": ["preinstall", "install", "postinstall", "prepare"] } },
              "review": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
